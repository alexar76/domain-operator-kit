# Safe default: simulated domains, DNS and payments. Node --env-file=.env src/server.js
# DOMAIN_MODE=auto publishes a demo (real RDAP availability, orders refused with demo_mode) that
# sells live on the first start after every live setting below is filled in; /healthz names what is missing.
DOMAIN_MODE=demo
DOMAIN_PROVIDER=demo
DOMAIN_PUBLIC_URL=http://127.0.0.1:9495
DOMAIN_DATA_DIR=./data
HOST=127.0.0.1
PORT=9495
DOMAIN_PRODUCT_ID=domains-operator
DOMAIN_SELLER_NAME=Independent domain operator
DOMAIN_MARKUP_USD=2.00
DOMAIN_TLDS=com,net,org

# For sandbox use DOMAIN_MODE=sandbox and DOMAIN_PROVIDER=openprovider.
# Sandbox credentials are separate from production credentials.
# OPENPROVIDER_USERNAME_FILE=/run/secrets/openprovider-username
# OPENPROVIDER_PASSWORD_FILE=/run/secrets/openprovider-password

# Live additionally needs HTTPS, seller terms, real payment/refund accounts, all-in costs.
# DOMAIN_MODE=live
# DOMAIN_PROVIDER=openprovider
# DOMAIN_PUBLIC_URL=https://domains.seller.example
# DOMAIN_TERMS_URL=https://seller.example/domain-terms
# DOMAIN_TERMS_VERSION=1
# DOMAIN_UPSTREAM_COST_CONFIRMED=1
# PAY_TO=0xYOUR_BASE_USDC_RECEIVING_ADDRESS
# CDP_KEY_FILE=/run/secrets/cdp.json
# DOMAIN_REFUND_KEY_FILE=/run/secrets/refund-wallet.key
# DOMAIN_REFUND_MAX_USD=100.00
# DOMAIN_REFUND_DAILY_USD=500.00
# BASE_RPC=https://YOUR_BASE_RPC_ENDPOINT
# DOMAIN_DATA_KEY_FILE=/run/secrets/domain-encryption.key
# DOMAIN_SIGNING_KEY_FILE=/run/secrets/domain-provider.pem

# Independent supplier bridge instead of Openprovider:
# DOMAIN_PROVIDER=http
# DOMAIN_SUPPLIER_URL=https://supplier.example/domain-kit
# DOMAIN_SUPPLIER_SECRET_FILE=/run/secrets/supplier-hmac.key
# DOMAIN_SUPPLIER_FEATURES=register,renew,info,dns,transfer_code

# Porkbun: sandbox-only until production validation; same API host, test keys.
# DOMAIN_MODE=sandbox
# DOMAIN_PROVIDER=porkbun
# DOMAIN_DATA_DIR=./data/porkbun
# PORKBUN_API_KEY_FILE=/run/secrets/porkbun-api-key
# PORKBUN_SECRET_KEY_FILE=/run/secrets/porkbun-secret-key
