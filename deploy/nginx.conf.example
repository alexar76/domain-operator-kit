# Include inside your existing TLS server block. Configure certificates separately.
# Do not log request bodies, payment headers, transfer codes or owner signatures.
location / {
    client_max_body_size 32k;
    proxy_pass http://127.0.0.1:9495;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_send_timeout 30s;
    proxy_next_upstream off;
    proxy_buffering off;
}
